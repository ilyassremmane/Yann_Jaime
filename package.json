    "@astrojs/vue": "^5.1.4",
    "@keystatic/astro": "^5.2.0",
    "@keystatic/core": "^0.6.9",
    "astro": "^5.18.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.19",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
