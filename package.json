{
  "name": "yann-jaime-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio en Astro SSG de l'artiste peintre Yann Jaime — série Tours Nuages, intérieurs, architectures et figures",
  "scripts": {
    "dev": "astro dev",
    "predev": "node scripts/remove-orphan-works.js && node scripts/build-cms-index.js && node scripts/compress-uploads.js",
    "build": "astro build",
    "prebuild": "node scripts/remove-orphan-works.js && node scripts/build-cms-index.js && node scripts/compress-uploads.js",
    "build:static": "KEYSTATIC_DISABLED=1 astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "astro check",
    "astro": "astro",
    "images:optimize": "node scripts/optimize-images.js",
    "images:safety": "node scripts/compress-uploads.js",
    "images:logo": "node scripts/optimize-logo.mjs",
    "content:seed": "node scripts/seed-content.mjs",
    "content:cleanup": "node scripts/remove-orphan-works.js",
    "content:index": "node scripts/build-cms-index.js"
  },
  "dependencies": {
    "@astrojs/node": "^9.5.5",
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.7.4",
