---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SecondaryGallery from '../../../components/SecondaryGallery.vue';
import {
  getSettings,
  getTheme,
  getThemes,
  getWorks,
  getWorksByTheme,
  paragraphs,
  themeTitle,
  workAlt,
  workMeta,
} from '../../../lib/content';
import { SITE_URL, artist, artwork, breadcrumbs, graph, website } from '../../../lib/seo';
import { type Locale, ui, withLocale } from '../../../lib/i18n';

export async function getStaticPaths() {
  const [themes, works] = await Promise.all([getThemes(), getWorks()]);
  return themes.flatMap((theme) =>
    works
      .filter((work) => work.theme === theme.slug)
      .map((work) => ({
        params: { theme: theme.slug, work: work.slug },
        props: { themeSlug: theme.slug, workSlug: work.slug },
      }))
  );
}

interface Props {
  themeSlug: string;
  workSlug: string;
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? 'fr';
const t = ui[locale];
const { themeSlug, workSlug } = Astro.props;

const [theme, themeWorks, settings] = await Promise.all([
  getTheme(themeSlug, locale),
  getWorksByTheme(themeSlug, locale),
  getSettings(locale),
]);

if (!theme) throw new Error(`Thème introuvable : ${themeSlug}`);
const work = themeWorks.find((item) => item.slug === workSlug);
if (!work) throw new Error(`Œuvre introuvable : ${workSlug}`);

const index = themeWorks.findIndex((item) => item.slug === workSlug);
const prev = index > 0 ? themeWorks[index - 1] : null;
const next = index < themeWorks.length - 1 ? themeWorks[index + 1] : null;

const themeName = await themeTitle(theme.slug, locale);

const meta = workMeta(work);
const description = paragraphs(work.description);
const gallery = work.gallery.map((src, galleryIndex) => ({
  src,
  alt: t.explorer.viewAlt(work.title, galleryIndex + 1),
}));

const seoDescription =
  description.length > 0
    ? description.join(' ').slice(0, 180)
    : t.explorer.seoFallback(work.title, work.year, work.technique);

const site = SITE_URL;
const worksPath = withLocale('/oeuvres', locale);
const themePath = withLocale(`/oeuvres/${theme.slug}`, locale);
const workPath = withLocale(`/oeuvres/${theme.slug}/${work.slug}`, locale);
const pageUrl = new URL(workPath, site).toString();
const structuredData = graph([
  artist(settings, site),
  website(settings, site, locale),
  artwork(work, site, pageUrl, locale),
  breadcrumbs(site, [
    { name: t.nav.home, url: withLocale('/', locale) },
    { name: t.nav.works, url: worksPath },
    { name: themeName, url: themePath },
    { name: work.title, url: workPath },
  ]),
]);
---

<BaseLayout
  locale={locale}
  title={work.title}
  description={seoDescription}
  ogImage={work.image}
  ogImageAlt={`${workAlt(work)}${work.technique ? ` — ${work.technique}` : ''}`}
  type="article"
  structuredData={structuredData}
>
  <article class="bg-white text-black" data-work-page>
    <div
      class="mx-auto flex w-full max-w-6xl flex-col px-4 py-6 sm:px-8 lg:min-h-[calc(100svh-5rem)]"
    >
      <nav
      class="mb-4 text-center text-xs uppercase tracking-[0.2em] text-black/50"
      aria-label={t.explorer.breadcrumbAria}
    >
      <a href={worksPath} class="link-underline hover:text-black">{t.nav.works}</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <a href={themePath} class="link-underline hover:text-black">{themeName}</a>
    </nav>

      <div class="grid flex-1 items-center gap-8 py-4 lg:grid-cols-12 lg:gap-14">
        <div class="order-1 lg:order-2 lg:col-span-8">
          <figure class="work-frame mx-auto max-w-full">
            {
              work.image ? (
                <button
                  type="button"
                  data-zoom-open
                  aria-label={t.explorer.zoomAria(work.title)}
                  class="group flex w-full cursor-zoom-in items-center justify-center focus-visible:outline-offset-4"
                >
                  <img
                    src={work.image}
                    alt={workAlt(work)}
                    class="max-h-[58vh] w-auto max-w-full object-contain"
                    fetchpriority="high"
                    decoding="async"
                  />
                </button>
              ) : (
                <div class="flex aspect-[4/3] items-center justify-center bg-neutral-100 text-xs uppercase tracking-[0.2em] text-black/50">
                  {t.explorer.comingSoon}
                </div>
              )
            }
            {
              work.image && (
                <figcaption class="mt-2 text-center text-[0.65rem] uppercase tracking-[0.2em] text-black/45">
                  {t.explorer.zoomHint}
                </figcaption>
              )
            }
          </figure>
        </div>

        <div class="order-2 text-left lg:order-1 lg:col-span-4">
          <p class="eyebrow text-black">{themeName}</p>
          <h1 class="font-display mt-3 text-lg leading-tight text-black sm:text-xl">{work.title}</h1>

          {
            meta.length > 0 && (
              <dl class="mt-5 space-y-1.5 border-t border-black/10 pt-4 text-sm">
                {work.technique && (
                  <div class="flex items-baseline gap-3">
                    <dt class="text-black/50">{t.explorer.techniqueLabel}</dt>
                    <dd class="text-black">{work.technique}</dd>
                  </div>
                )}
                {work.dimensions && (
                  <div class="flex items-baseline gap-3">
                    <dt class="text-black/50">{t.explorer.dimensionsLabel}</dt>
                    <dd class="text-black">{work.dimensions}</dd>
                  </div>
                )}
                {work.year && (
                  <div class="flex items-baseline gap-3">
                    <dt class="text-black/50">{t.explorer.yearLabel}</dt>
                    <dd class="text-black">{work.year}</dd>
                  </div>
                )}
              </dl>
            )
          }

          {
            description.length > 0 && (
              <div class="mt-6 space-y-4 text-left text-[0.95rem] leading-relaxed text-black">
                {description.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            )
          }

          <a
            href={withLocale('/contact', locale)}
            class="link-underline mt-8 inline-block text-xs uppercase tracking-[0.2em] text-black"
          >
            {t.explorer.requestInfo}
          </a>

          <p class="mt-6 hidden text-[0.65rem] uppercase tracking-[0.2em] text-black/40 lg:block">
            {t.explorer.keyboardHint}
          </p>
        </div>
      </div>
    </div>

      {
        gallery.length > 0 && (
          <section class="mx-auto mt-16 max-w-5xl border-t border-black/10 pt-8">
            <h2 class="eyebrow mb-6 text-center text-black">{t.explorer.imagesTitle}</h2>
            <SecondaryGallery client:visible images={gallery} locale={locale} />
          </section>
        )
      }

      <nav
        class="mt-8 flex items-center justify-between gap-4 border-t border-black/10 pt-5 text-xs uppercase tracking-[0.2em]"
        aria-label={t.explorer.imagesNavAria}
      >
        <div class="flex w-full items-center justify-between gap-4 pb-4">
          {
            prev ? (
              <a
                data-nav-prev
                href={withLocale(`/oeuvres/${theme.slug}/${prev.slug}`, locale)}
                class="link-underline max-w-[45%] text-black/60 hover:text-black"
              >
                {t.explorer.navPrev}: {prev.title}
              </a>
            ) : (
              <span></span>
            )
          }
          {
            next ? (
              <a
                data-nav-next
                href={withLocale(`/oeuvres/${theme.slug}/${next.slug}`, locale)}
                class="link-underline max-w-[45%] text-right text-black/60 hover:text-black"
              >
                {next.title} — {t.explorer.navNext}
              </a>
            ) : (
              <span></span>
            )
          }
        </div>
      </nav>

    <div
      data-zoom
      hidden
      class="fixed inset-0 z-[60] flex-col bg-canvas/95 backdrop-blur-md"
      role="dialog"
      aria-modal="true"
      aria-label={t.explorer.zoomAria(work.title)}
    >
      <div class="flex items-center justify-between gap-4 px-4 py-4 sm:px-8">
        <p class="font-display truncate text-lg text-ink">{work.title}</p>
        <button
          type="button"
          data-zoom-close
          class="shrink-0 rounded-full border border-ink/25 px-3 py-1.5 text-[0.6rem] uppercase tracking-[0.2em] text-ink transition-colors hover:border-ink"
          aria-label={t.explorer.closeAria}
        >
          {t.explorer.close}
        </button>
      </div>
      <div class="flex flex-1 items-center justify-center overflow-hidden px-3 pb-6 sm:px-8">
        <img data-zoom-img alt="" class="max-h-full max-w-full object-contain" />
      </div>
    </div>

    <script>
      import { navigate } from 'astro:transitions/client';

      /* ── Visionneuse plein écran ── */
      const zoomLayer = (page: HTMLElement) => page.querySelector<HTMLElement>('[data-zoom]');

      const closeZoom = (page: HTMLElement) => {
        const zoom = zoomLayer(page);
        const image = zoom?.querySelector<HTMLImageElement>('[data-zoom-img]');
        if (!zoom || !image || zoom.classList.contains('hidden')) return;
        zoom.classList.add('hidden');
        zoom.classList.remove('flex');
        image.src = '';
        document.documentElement.style.overflow = '';
        page.querySelector<HTMLButtonElement>('[data-zoom-open]')?.focus();
      };

      const setup = () => {
        const page = document.querySelector<HTMLElement>('[data-work-page]');
        if (!page || page.dataset.navReady === '1') return;
        page.dataset.navReady = '1';

        const zoom = zoomLayer(page);
        const zoomImage = zoom?.querySelector<HTMLImageElement>('[data-zoom-img]');

        page.querySelectorAll<HTMLButtonElement>('[data-zoom-open]').forEach((button) => {
          button.addEventListener('click', () => {
            const image = button.querySelector('img');
            if (!image || !zoom || !zoomImage) return;
            zoomImage.src = image.currentSrc || image.src;
            zoomImage.alt = image.alt;
            zoom.classList.remove('hidden');
            zoom.classList.add('flex');
            document.documentElement.style.overflow = 'hidden';
            zoom.querySelector<HTMLButtonElement>('[data-zoom-close]')?.focus();
          });
        });

        // Un clic n'importe où dans la visionneuse (sauf l'image) la ferme.
        zoom?.addEventListener('click', (event) => {
          if (event.target !== zoomImage) closeZoom(page);
        });
      };

      /* ── Navigation entre œuvres au clavier (← / →) ── */
      let keysRegistered = false;
      const registerKeys = () => {
        if (keysRegistered) return;
        keysRegistered = true;

        window.addEventListener('keydown', (event) => {
          const page = document.querySelector<HTMLElement>('[data-work-page]');
          if (!page) return;

          const zoom = zoomLayer(page);
          if (zoom && !zoom.classList.contains('hidden')) {
            if (event.key === 'Escape') closeZoom(page);
            return;
          }

          if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey) return;
          const target = event.target;
          if (
            target instanceof HTMLElement &&
            target.closest('input, textarea, select, [contenteditable="true"]')
          ) {
            return;
          }

          if (event.key === 'ArrowLeft') {
            const prev = page.querySelector<HTMLAnchorElement>('[data-nav-prev]');
            if (prev) navigate(prev.href);
          } else if (event.key === 'ArrowRight') {
            const next = page.querySelector<HTMLAnchorElement>('[data-nav-next]');
            if (next) navigate(next.href);
          }
        });
      };

      document.addEventListener('astro:page-load', () => {
        setup();
        registerKeys();
      });
      setup();
      registerKeys();
    </script>
  </article>
</BaseLayout>