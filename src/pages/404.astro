---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localeFromPath, ui, withLocale } from '../lib/i18n';

/* Page d'erreur unique : la langue est déduite du chemin demandé. */
const locale = localeFromPath(Astro.url.pathname);
const t = ui[locale];
---

<BaseLayout locale={locale} title={t.notFound.title} noindex>
  <section class="mx-auto flex max-w-gallery flex-col items-start justify-center px-4 py-24 sm:px-8 sm:py-32">
    <p class="eyebrow">{t.notFound.eyebrow}</p>
    <h1 class="font-display mt-4 text-lg leading-tight text-ink sm:text-xl">
      {t.notFound.heading}
    </h1>
    <p class="mt-6 max-w-measure text-sm leading-relaxed text-clay">
      {t.notFound.text}
    </p>
    <div class="mt-10 flex flex-wrap gap-6 text-xs uppercase tracking-[0.2em]">
      <a href={withLocale('/oeuvres', locale)} class="link-underline text-ink">{t.notFound.worksLink}</a>
      <a href={withLocale('/', locale)} class="link-underline text-clay hover:text-ink">
        {t.notFound.homeLink}
      </a>
    </div>
  </section>
</BaseLayout>