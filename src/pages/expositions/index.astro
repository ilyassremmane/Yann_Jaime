---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  expositionMeta,
  expositionType,
  getExpositions,
  getSettings,
  thumbFor,
} from '../../lib/content';
import { SITE_URL, artist, breadcrumbs, graph, imageCollectionPage, website } from '../../lib/seo';
import { type Locale, ui, withLocale } from '../../lib/i18n';

interface Props {
  /** `fr` par défaut ; la version anglaise passe `locale="en"` (voir /en/). */
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? 'fr';
const t = ui[locale];

const [expositions, settings] = await Promise.all([getExpositions(locale), getSettings(locale)]);

const description = t.expoPage.description;

const site = SITE_URL;
const expoIndexPath = withLocale('/expositions', locale);
const pageUrl = new URL(expoIndexPath, site).toString();
const structuredData = graph([
  artist(settings, site),
  website(settings, site, locale),
  imageCollectionPage({
    site,
    url: pageUrl,
    name: t.expoPage.jsonLd,
    description,
    id: locale === 'en' ? '/en/expositions/#collection' : '/expositions/#collection',
    locale,
    items: expositions.map((exposition) => ({
      url: withLocale(`/expositions/${exposition.slug}`, locale),
      name: exposition.title,
      image: exposition.cover || undefined,
    })),
  }),
  breadcrumbs(site, [
    { name: t.nav.home, url: withLocale('/', locale) },
    { name: t.nav.expositions, url: expoIndexPath },
  ]),
]);
---

<BaseLayout
  locale={locale}
  title={t.expoPage.title}
  description={description}
  structuredData={structuredData}
>
  <section class="mx-auto max-w-gallery px-4 py-12 sm:px-8 sm:py-16">
    <header class="mb-10 border-b border-ink/10 pb-6">
      <p class="eyebrow">{t.expoPage.eyebrow}</p>
      <div class="mt-3 flex flex-wrap items-baseline justify-between gap-3">
        <h1 class="font-display text-lg tracking-[0.01em] text-ink sm:text-xl">
          {t.expoPage.title}
        </h1>
        <p class="text-xs uppercase tracking-[0.2em] text-clay">
          {t.expoPage.count(expositions.length)}
        </p>
      </div>
      <p class="mt-4 max-w-measure text-sm leading-relaxed text-clay">
        {t.expoPage.intro}
        <a href={withLocale('/oeuvres', locale)} class="link-underline text-ink">
          {t.expoPage.introLink}
        </a>{t.expoPage.introEnd}
      </p>
    </header>

    {
      expositions.length === 0 ? (
        <p class="py-16 text-center text-sm text-clay">{t.expoPage.empty}</p>
      ) : (
        <div class="grid grid-cols-1 gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {expositions.map((exposition, index) => (
            <article class="group">
              <a
                href={withLocale(`/expositions/${exposition.slug}`, locale)}
                class="block focus-visible:outline-offset-4"
              >
                <figure class="work-frame overflow-hidden">
                  <div class="aspect-[4/3] overflow-hidden bg-linen">
                    {exposition.cover ? (
                      <img
                        src={thumbFor(exposition.cover)}
                        alt={t.expoPage.coverAlt(exposition.title)}
                        data-fade
                        width="1200"
                        height="900"
                        loading={index < 3 ? 'eager' : 'lazy'}
                        decoding="async"
                        fetchpriority={index < 3 ? 'high' : 'auto'}
                        class="h-full w-full object-cover transition-transform duration-[1200ms] ease-soft group-hover:scale-[1.03]"
                      />
                    ) : (
                      <div class="flex h-full w-full items-center justify-center text-xs uppercase tracking-[0.2em] text-clay">
                        {t.expoPage.comingSoon}
                      </div>
                    )}
                  </div>
                </figure>
                <div class="mt-4">
                  <p class="eyebrow text-[0.6rem]">{expositionType(exposition.type, locale)}</p>
                  <h2 class="font-display mt-2 text-xl leading-snug text-ink sm:text-2xl">
                    {exposition.title}
                  </h2>
                  {expositionMeta(exposition).length > 0 && (
                    <p class="mt-1 text-xs leading-relaxed text-clay">
                      {expositionMeta(exposition).join(' · ')}
                    </p>
                  )}
                </div>
              </a>
            </article>
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
