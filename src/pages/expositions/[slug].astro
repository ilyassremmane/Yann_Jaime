---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SecondaryGallery from '../../components/SecondaryGallery.vue';
import type { Exposition } from '../../lib/content';
import {
  expositionMeta,
  expositionType,
  getExpositionNeighbours,
  getExpositions,
  getSettings,
  paragraphs,
} from '../../lib/content';
import { SITE_URL, artist, breadcrumbs, expositionEvent, graph, website } from '../../lib/seo';
import { type Locale, ui, withLocale } from '../../lib/i18n';

export async function getStaticPaths() {
  const expositions = await getExpositions();
  return expositions.map((exposition) => ({
    params: { slug: exposition.slug },
    props: { exposition },
  }));
}

interface Props {
  exposition: Exposition;
  /** `fr` par défaut ; la version anglaise passe `locale="en"` (voir /en/). */
  locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? 'fr';
const t = ui[locale];
const { exposition: source } = Astro.props;

/* Même URL dans les deux langues : on relit l'exposition dans la langue demandée. */
const [expositions, { prev, next }, settings] = await Promise.all([
  getExpositions(locale),
  getExpositionNeighbours(source.slug, locale),
  getSettings(locale),
]);
const exposition = expositions.find((item) => item.slug === source.slug) ?? source;

const meta = expositionMeta(exposition);
const text = paragraphs(exposition.description);
const gallery = exposition.gallery.map((src, index) => ({
  src,
  alt: t.expoPage.viewAlt(exposition.title, index + 1),
}));

const seoDescription =
  text.length > 0
    ? text.join(' ').slice(0, 180)
    : t.expoPage.seoFallback(exposition.title, meta.join(', '));

const site = SITE_URL;
const expoIndexPath = withLocale('/expositions', locale);
const expoPath = withLocale(`/expositions/${exposition.slug}`, locale);
const pageUrl = new URL(expoPath, site).toString();
const structuredData = graph([
  artist(settings, site),
  website(settings, site, locale),
  expositionEvent(exposition, site, pageUrl, locale),
  breadcrumbs(site, [
    { name: t.nav.home, url: withLocale('/', locale) },
    { name: t.nav.expositions, url: expoIndexPath },
    { name: exposition.title, url: expoPath },
  ]),
]);
---

<BaseLayout
  locale={locale}
  title={exposition.title}
  description={seoDescription}
  image={exposition.cover}
  imageAlt={t.expoPage.ogAlt(exposition.title)}
  type="article"
  structuredData={structuredData}
>
  <article class="mx-auto max-w-gallery px-4 py-10 sm:px-8 sm:py-16">
    <nav class="mb-8 text-xs uppercase tracking-[0.2em] text-clay" aria-label={t.expoPage.breadcrumbAria}>
      <a href={expoIndexPath} class="link-underline hover:text-ink">{t.nav.expositions}</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span class="text-ink/60">{expositionType(exposition.type, locale)}</span>
    </nav>

    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <!-- Visuel principal -->
      <div class="lg:col-span-8">
        <figure class="work-frame overflow-hidden">
          {exposition.cover ? (
            <img
              src={exposition.cover}
              alt={t.expoPage.coverAlt(exposition.title)}
              class="w-full"
              fetchpriority="high"
              decoding="async"
            />
          ) : (
            <div class="flex aspect-[4/3] items-center justify-center bg-linen text-xs uppercase tracking-[0.2em] text-clay">
              {t.expoPage.comingSoon}
            </div>
          )}
        </figure>
      </div>

      <!-- Fiche de l'exposition -->
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-28">
          <p class="eyebrow">{expositionType(exposition.type, locale)}</p>
          <h1 class="font-display mt-3 text-lg leading-tight text-ink sm:text-xl">
            {exposition.title}
          </h1>

          {meta.length > 0 && (
            <p class="mt-4 text-sm leading-relaxed text-clay">{meta.join(' · ')}</p>
          )}

          {text.length > 0 && (
            <div class="mt-6 space-y-4 text-sm leading-relaxed text-ink/80">
              {text.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          )}

          {exposition.link && (
            <a
              href={exposition.link}
              target="_blank"
              rel="noopener noreferrer"
              class="link-underline mt-8 inline-block text-xs uppercase tracking-[0.2em] text-ink"
            >
              {t.expoPage.visitSite}
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Galerie -->
    {gallery.length > 0 && (
      <section class="mt-16 border-t border-ink/10 pt-8">
        <h2 class="eyebrow mb-6">{t.expoPage.viewsTitle}</h2>
        <SecondaryGallery client:visible images={gallery} locale={locale} />
      </section>
    )}

    <!-- Navigation entre expositions -->
    <nav
      class="mt-16 flex items-center justify-between gap-4 border-t border-ink/10 pt-6 text-xs uppercase tracking-[0.2em]"
      aria-label={t.expoPage.navAria}
    >
      {prev ? (
        <a
          href={withLocale(`/expositions/${prev.slug}`, locale)}
          class="link-underline max-w-[45%] truncate text-clay hover:text-ink"
        >
          ← {prev.title}
        </a>
      ) : (
        <span />
      )}
      {next ? (
        <a
          href={withLocale(`/expositions/${next.slug}`, locale)}
          class="link-underline max-w-[45%] truncate text-right text-clay hover:text-ink"
        >
          {next.title} →
        </a>
      ) : (
        <span />
      )}
    </nav>
  </article>
</BaseLayout>
