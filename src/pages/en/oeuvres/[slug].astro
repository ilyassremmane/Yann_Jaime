---
/**
 * Fiche d'œuvre — version anglaise (`/en/oeuvres/<slug>`).
 *
 * Les URL sont identiques dans les deux langues (bon pour le référencement) :
 * on régénère donc les mêmes chemins, en passant `locale="en"` à la page.
 */
import Page from '../../oeuvres/[slug].astro';
import { getWorks } from '../../../lib/content';

export async function getStaticPaths() {
  const works = await getWorks();
  return works.map((work) => ({ params: { slug: work.slug }, props: { work } }));
}

const { work } = Astro.props;
---

<Page work={work} locale="en" />
