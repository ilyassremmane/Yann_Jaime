---
/* Fiche d'œuvre — version anglaise (`/en/oeuvres/<thème>/<œuvre>`). */
import Page from '../../../oeuvres/[theme]/[work].astro';
import { getThemes, getWorks } from '../../../../lib/content';

export async function getStaticPaths() {
  const [themes, works] = await Promise.all([getThemes(), getWorks()]);
  return themes.flatMap((theme) =>
    works
      .filter((work) => work.theme === theme.slug)
      .map((work) => ({
        params: { theme: theme.slug, work: work.slug },
        props: { themeSlug: theme.slug, workSlug: work.slug },
      }))
  );
}

const { themeSlug, workSlug } = Astro.props;
---

<Page themeSlug={themeSlug} workSlug={workSlug} locale="en" />
