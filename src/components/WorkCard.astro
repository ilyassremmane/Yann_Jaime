---
import type { Work } from '../lib/content';
import { themeLabel, thumbFor, workMeta } from '../lib/content';
import { type Locale, ui, withLocale } from '../lib/i18n';

interface Props {
  work: Work;
  /** Charge l'image en priorité (hero, premières vignettes visibles). */
  priority?: boolean;
  size?: 'default' | 'large';
  /** Index dans la grille : décale légèrement l'apparition. */
  index?: number;
  /** Langue de la page (libellés et lien vers la fiche). */
  locale?: Locale;
  /**
   * `true` (défaut) = image encadrée : fond blanc + filet, hauteur naturelle.
   * `false` (accueil) = sans cadre : chaque photo occupe 100 % de la largeur
   * de la colonne (les formats non carrés s'affichent en grand), centrée
   * verticalement dans la rangée ; le bloc titre a une hauteur minimale fixe,
   * donc les titres s'alignent ligne par ligne.
   */
  frame?: boolean;
}

const { work, priority = false, index = 0, locale = 'fr', frame = true } = Astro.props;
const t = ui[locale];
const meta = workMeta(work);
const ratioClass = frame
  ? 'relative flex items-center justify-center bg-white p-0 overflow-hidden'
  /* Sans cadre : largeur 100 % de la colonne, hauteur naturelle de l'image */
  : 'relative w-full overflow-hidden';
const imgClass = frame
  ? 'block h-auto w-full max-w-full object-contain transition-transform duration-[1200ms] ease-soft group-hover:scale-[1.02]'
  : 'block h-auto w-full object-contain transition-transform duration-[1200ms] ease-soft group-hover:scale-[1.02]';
---

<article
  class:list={['work-card group', !frame && 'flex h-full flex-col']}
  style={`--card-delay: ${Math.min(index % 12, 11) * 55}ms`}
>
  <a
    href={withLocale(`/oeuvres/${work.theme}/${work.slug}`, locale)}
    data-work-card={work.slug}
    class:list={[frame ? 'block' : 'flex h-full flex-col', 'focus-visible:outline-offset-4']}
  >
    <figure
      class:list={
        frame
          ? 'work-frame overflow-hidden bg-white'
          : /* La figure occupe toute la hauteur de la rangée : l'image est
               centrée verticalement, la ligne de titre reste au même niveau. */
            'flex w-full flex-1 items-center justify-center overflow-hidden'
      }
    >
      <div class={ratioClass}>
        {
          work.image ? (
            <img
              src={thumbFor(work.image)}
              alt={`${work.title}${work.year ? `, ${work.year}` : ''}`}
              data-fade
              loading={priority ? 'eager' : 'lazy'}
              decoding="async"
              fetchpriority={priority ? 'high' : 'auto'}
              class={imgClass}
            />
          ) : (
            <div class="flex min-h-48 w-full items-center justify-center text-xs uppercase tracking-[0.2em] text-clay">
              {t.explorer.comingSoon}
            </div>
          )
        }
      </div>
    </figure>

    <!-- Hauteur minimale fixe : le premier trait de titre démarre toujours au même endroit -->
    <div class:list={[frame ? 'mt-4' : 'mt-4 min-h-[7.5rem]']}>
      <h3 class="font-display text-lg leading-snug text-ink sm:text-xl">
        {work.title}
        {work.year && <span class="text-clay">, {work.year}</span>}
      </h3>
      {meta.length > 0 && <p class="mt-1 text-xs leading-relaxed text-clay">{meta.join(' · ')}</p>}
      <p class="eyebrow mt-2 text-[0.6rem]">{themeLabel(work.theme, locale)}</p>
    </div>
  </a>
</article>