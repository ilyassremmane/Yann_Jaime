---
import type { Theme } from '../lib/content';
import { themeAlt, thumbFor } from '../lib/content';
import { type Locale, ui, withLocale } from '../lib/i18n';

interface Props {
  theme: Theme;
  /** URL résolue de la couverture (CMS → œuvre choisie → repli). */
  cover: string | null;
  /** Nombre d'œuvres rattachées au thème. */
  count: number;
  /** Charge l'image en priorité (premières cartes visibles). */
  priority?: boolean;
  /** Langue de la page (libellés et lien vers la page du thème). */
  locale?: Locale;
}

const { theme, cover, count, priority = false, locale = 'fr' } = Astro.props;
const t = ui[locale];
---

<article class="work-card group">
  <a href={withLocale(`/oeuvres/${theme.slug}`, locale)} class="block focus-visible:outline-offset-4">
    <figure class="work-frame overflow-hidden">
      <div class="aspect-[4/3] overflow-hidden bg-linen">
        {
          cover ? (
            <img
              src={thumbFor(cover)}
              alt={themeAlt(theme)}
              data-fade
              width="1200"
              height="900"
              loading={priority ? 'eager' : 'lazy'}
              decoding="async"
              fetchpriority={priority ? 'high' : 'auto'}
              class="h-full w-full object-cover transition-transform duration-[1200ms] ease-soft group-hover:scale-[1.03]"
            />
          ) : (
            <div class="flex h-full w-full items-center justify-center text-xs uppercase tracking-[0.2em] text-clay">
              {t.explorer.comingSoon}
            </div>
          )
        }
      </div>
    </figure>

    <div class="mt-4 text-center">
      <h2 class="font-display text-lg leading-snug text-ink sm:text-xl">
        {theme.title}
      </h2>
      {theme.tagline && <p class="mx-auto mt-2 max-w-measure text-sm leading-relaxed text-clay">{theme.tagline}</p>}
      <p class="eyebrow mt-3 text-[0.6rem]">{t.worksPage.themeCount(count)}</p>
    </div>
  </a>
</article>